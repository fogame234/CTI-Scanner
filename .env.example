# ══════════════════════════════════════════════════════════════════════
#  CTI Telegram Scanner — Configuration
# ══════════════════════════════════════════════════════════════════════

# ── Telegram Client API (required) ───────────────────────────────────
# Get these from https://my.telegram.org → "API development tools"
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=+1234567890

# ── Session file ──────────────────────────────────────────────────────
# Path to the Telethon session file. Docker users should point this
# to a persistent volume (e.g. /app/data/cti_scanner).
SESSION_NAME=cti_scanner

# ── Database ──────────────────────────────────────────────────────────
# 'sqlite' or 'elasticsearch'
DB_BACKEND=sqlite
DB_PATH=cti_scanner.db

# ── Elasticsearch (only when DB_BACKEND=elasticsearch) ────────────────
# ES_HOSTS=http://localhost:9200
# ES_USERNAME=
# ES_PASSWORD=
# ES_API_KEY=
# ES_CA_CERTS=
# ES_VERIFY=true
# ES_INDEX_PREFIX=cti

# ── Web UI ────────────────────────────────────────────────────────────
WEB_HOST=0.0.0.0
WEB_PORT=8080

# ── Companion Telegram Bot (optional) ─────────────────────────────────
# See COMPANION-BOT.md for setup instructions.
# TELEGRAM_BOT_TOKEN=

# ── Scanner tuning ────────────────────────────────────────────────────
BACKFILL_INTERVAL=3600
BACKFILL_LIMIT=500

# ── Alert keywords (comma-separated) ─────────────────────────────────
# These can also be managed from Settings > Keywords in the web UI.
ALERT_KEYWORDS=ransomware,stealer log,CVE-,0day,zero-day,data leak,credential dump

# ── Auto-discovery (optional) ────────────────────────────────────────
# Comma-separated search terms. The scanner periodically searches
# Telegram for channels matching these and presents them for review
# on the Discovery page. Leave blank to disable.
# DISCOVERY_KEYWORDS=
# DISCOVERY_INTERVAL=21600
# DISCOVERY_MIN_MEMBERS=500

# ── ntfy notifications (optional) ────────────────────────────────────
# Can also be configured entirely from Settings > Notifications.
# If set here, values are imported into the database on first run.
# NTFY_URL=https://ntfy.example.com
# NTFY_TOPIC=cti-alerts
# NTFY_TOKEN=
# NTFY_PRIORITY_ALERT=4
# NTFY_PRIORITY_HEALTH=5

# ── Data retention ────────────────────────────────────────────────────
RETAIN_DAYS=90
RETAIN_IOCS_DAYS=180
RETAIN_ALERTS_DAYS=90
ARCHIVE_DIR=archives
RETENTION_INTERVAL=86400

# ── Health check ──────────────────────────────────────────────────────
HEALTH_STALE_THRESHOLD=600
